# Copy this file to .env and fill in credentials locally. Never commit .env.
DATABASE_PATH=data/automation.sqlite3
OUTPUT_DIR=generated
BACKGROUND_MUSIC=

YOUTUBE_API_KEY=
GEMINI_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DASHBOARD_URL=http://localhost:8501

# Optional paths/configuration for later milestones
YOUTUBE_OAUTH_CLIENT_SECRETS=secrets/youtube-client-secret.json
FFMPEG_PATH=ffmpeg
YOUTUBE_REGION=IN
YOUTUBE_RESULT_LIMIT=8
YOUTUBE_UPLOAD_PRIVACY=private
YOUTUBE_MADE_FOR_KIDS=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_VIDEO_MODEL=veo-3.1-generate-preview
# local avoids paid video generation; set veo only if you knowingly enable paid Veo usage.
VIDEO_PROVIDER=local
# local uses an installed Windows voice; azure is optional and quota/price dependent.
SPEECH_PROVIDER=local
VIDEO_ASPECT_RATIO=9:16
STORY_SCENE_COUNT=5
AZURE_TELUGU_VOICE=te-IN-ShrutiNeural
AZURE_ENGLISH_VOICE=en-US-AriaNeural
TELEGRAM_POLL_SECONDS=5
YOUTUBE_API_DATA_RETENTION_DAYS=30
SCHEDULED_TOPIC=
SCHEDULED_LANGUAGE=te
